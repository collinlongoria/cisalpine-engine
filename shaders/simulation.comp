#version 460 core

layout(local_size_x = 32, local_size_y = 32) in;

layout(rgba8ui, binding = 0) uniform readonly uimage2D stateIn;
layout(rgba8ui, binding = 1) uniform writeonly uimage2D stateOut;
layout(rgba16f, binding = 3) uniform readonly image2D forceField;

struct ElementData {
    vec4 color;                // 0-15
    int type;                  // 16-19
    float density;             // 20-23
    float viscosity;           // 24-27
    float probability;         // 28-31
    int flammability;          // 32-35
    int glow;                  // 36-39
    int maxLife;               // 40-43
    int gemstone;              // 44-47
    float lightRadius;         // 48-51
    float lightIntensity;      // 52-55
    float ior;                 // 56-59
    float opacity;             // 60-63
    float specularPower;       // 64-67
    int _pad1, _pad2, _pad3;   // 68-79
    vec4 transmissionTint;     // 80-95
    float baseHeight;          // 96-99
    float colorVariation;      // 100-103
    int animType;              // 104-107
    float mass;                // 108-111
};

layout(std430, binding = 2) buffer ElementRegistry {
    ElementData elements[];
};

layout(std430, binding = 4) buffer ChunkGridRead {
    uint chunkGridRead[];
};

layout(std430, binding = 5) buffer ChunkGridWrite {
    uint chunkGridWrite[];
};

layout(std430, binding = 6) buffer ActiveChunkList {
    uint num_groups_x;
    uint num_groups_y;
    uint num_groups_z;
    uint active_chunk_ids[];
};

// Phase 1: Effector List SSBO for writing effectors
struct Effector {
    vec2 position;       // 8 bytes
    uint type;           // 4 bytes (0 = Black Hole, 1 = Bomb)
    float strength;      // 4 bytes
};

layout(std430, binding = 8) buffer EffectorList {
    uint effectorCount;
    uint _eff_pad1;
    uint _eff_pad2;
    uint _eff_pad3;
    Effector effectors[];
};
uniform vec2  worldSize;
uniform float time;
uniform uint  frameCount;
uniform bool  useChunkSleep;
uniform float globalEntropy;

const int TYPE_STATIC   = 0;
const int TYPE_GRANULAR = 1;
const int TYPE_LIQUID   = 2;
const int TYPE_GAS      = 3;

const uint BOMB_FUSE_TICKS  = 250u;
const float BOMB_DESTROY_RADIUS = 12.0;

const int CHUNK_WAKE_MARGIN = 2;


// Phase 1: Write an effector to the SSBO
void emitEffector(vec2 position, uint type, float strength) {
    uint slot = atomicAdd(effectorCount, 1u);
    if (slot < uint(MAX_EFFECTORS)) {
        effectors[slot].position = position;
        effectors[slot].type = type;
        effectors[slot].strength = strength;
    }
}

void wakeChunk(ivec2 pixelPos) {
    if (!useChunkSleep) return;
    if (pixelPos.x < 0 || pixelPos.x >= int(worldSize.x) ||
        pixelPos.y < 0 || pixelPos.y >= int(worldSize.y)) return;

    int cx = pixelPos.x / CHUNK_SIZE;
    int cy = pixelPos.y / CHUNK_SIZE;
    uint idx = uint(cy * CHUNK_GRID_W + cx);
    chunkGridWrite[idx] = 1u;
}

void wakeChunkAndNeighbors(ivec2 pos) {
    wakeChunk(pos);

    if (!useChunkSleep) return;

    int localX = pos.x % CHUNK_SIZE;
    int localY = pos.y % CHUNK_SIZE;

    // left edge
    if (localX < CHUNK_WAKE_MARGIN) {
        wakeChunk(pos + ivec2(-CHUNK_SIZE, 0));
    }
    // right edge
    if (localX >= CHUNK_SIZE - CHUNK_WAKE_MARGIN) {
        wakeChunk(pos + ivec2(CHUNK_SIZE, 0));
    }
    // bottom edge
    if (localY < CHUNK_WAKE_MARGIN) {
        wakeChunk(pos + ivec2(0, -CHUNK_SIZE));
    }
    // top edge
    if (localY >= CHUNK_SIZE - CHUNK_WAKE_MARGIN) {
        wakeChunk(pos + ivec2(0, CHUNK_SIZE));
    }
    // Corners
    if (localX < CHUNK_WAKE_MARGIN && localY < CHUNK_WAKE_MARGIN) {
        wakeChunk(pos + ivec2(-CHUNK_SIZE, -CHUNK_SIZE));
    }
    if (localX >= CHUNK_SIZE - CHUNK_WAKE_MARGIN && localY < CHUNK_WAKE_MARGIN) {
        wakeChunk(pos + ivec2(CHUNK_SIZE, -CHUNK_SIZE));
    }
    if (localX < CHUNK_WAKE_MARGIN && localY >= CHUNK_SIZE - CHUNK_WAKE_MARGIN) {
        wakeChunk(pos + ivec2(-CHUNK_SIZE, CHUNK_SIZE));
    }
    if (localX >= CHUNK_SIZE - CHUNK_WAKE_MARGIN && localY >= CHUNK_SIZE - CHUNK_WAKE_MARGIN) {
        wakeChunk(pos + ivec2(CHUNK_SIZE, CHUNK_SIZE));
    }
}

// Helpers

bool inBounds(ivec2 p) {
    return (p.x >= 0 && p.x < int(worldSize.x) &&
            p.y >= 0 && p.y < int(worldSize.y));
}

float random01(ivec2 pos) {
    return fract(sin(dot(vec2(pos) + time, vec2(12.9898, 78.233))) * 43758.5453);
}

// because one hash isnt enough :(
float random01b(ivec2 pos) {
    return fract(sin(dot(vec2(pos) + time * 1.7, vec2(39.346, 11.135))) * 23421.6312);
}

uint hashU32(uint x) {
    x ^= x >> 16;
    x *= 2246822519u;
    x ^= x >> 13;
    x *= 3266489917u;
    x ^= x >> 16;
    return x;
}

uint hash2u(uvec2 v) {
    return hashU32(v.x ^ (v.y + 0x9e3779b9u + (v.x<<6) + (v.x>>2)));
}

uint hash3u(uvec2 v, uint salt) {
    return hashU32(v.x ^ (v.y + salt + 0x9e3779b9u + (v.x<<6) + (v.x>>2)));
}

uvec4 getState(ivec2 pos) {
    if (!inBounds(pos)) {
        return uvec4(255u, 0u, 0u, 0u);
    }
    return imageLoad(stateIn, pos);
}

uint getElement(ivec2 pos) { return getState(pos).r; }
uint getLife(ivec2 pos) { return getState(pos).g; }

vec2 getForce(ivec2 pos) {
    if (!inBounds(pos)) return vec2(0.0);
    return imageLoad(forceField, pos).rg;
}

bool isDoomed(ivec2 pos) {
    // Check surroundings for Void or BlackHole
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            uint neighbor = getElement(pos + ivec2(dx, dy));
            if (neighbor == VOID || neighbor == BLACKHOLE) return true;
        }
    }
    return false;
}

// Type checks

bool isStatic(uint id) {
    return id < MAX_ELEMENTS && elements[id].type == TYPE_STATIC;
}

bool isGranular(uint id) {
    return id < MAX_ELEMENTS && elements[id].type == TYPE_GRANULAR;
}

bool isLiquid(uint id) {
    return id < MAX_ELEMENTS && elements[id].type == TYPE_LIQUID;
}

bool isGas(uint id) {
    return id < MAX_ELEMENTS && elements[id].type == TYPE_GAS;
}

bool isEmpty(uint id) {
    return id == EMPTY;
}

bool isImmobile(uint id) {
    if (id >= MAX_ELEMENTS) return true;
    return elements[id].type == TYPE_STATIC;
}

bool isFlammable(uint id) {
    return id < MAX_ELEMENTS && elements[id].flammability == 1;
}

bool isGlowing(uint id) {
    return id < MAX_ELEMENTS && elements[id].glow == 1;
}

bool hasLife(uint id) {
    return id < MAX_ELEMENTS && elements[id].maxLife > 0;
}

bool isIndestructible(uint id) {
    return id == VOID || id == BLACKHOLE;
}

// Movement Logic

bool canDisplace(uint mover, uint target) {
    if (target == EMPTY) return true;
    if (mover == target) return false;
    if (mover >= MAX_ELEMENTS || target >= MAX_ELEMENTS) return false;

    if (target == VOID || target == BLACKHOLE) return false;

    float dMover = elements[mover].density;
    float dTarget = elements[target].density;

    // Fire destroys smoke
    if (mover == FIRE && target == SMOKE) return true;

    // Heavier things displace lighter fluids/gases
    if (dMover > dTarget && (isLiquid(target) || isGas(target))) return true;

    // Lava/Fire burns flammable things
    if ((mover == LAVA || mover == FIRE) && isFlammable(target)) return true;

    return false;
}

// Force-biased movement

ivec2 forceBasedDest(ivec2 src, uint elem, vec2 force) {
    float forceMag = length(force);

    // Static elements need much stronger force to be moved
    float threshold = 0.5;
    float moveScale = 0.15;
    if (isStatic(elem) && elem != VOID && elem != BLACKHOLE) {
        threshold = 5.0;
        moveScale = 0.08;
    }
    else if (isGranular(elem)) {
        threshold = 0.3;
        moveScale = 0.18;
    }

    if (forceMag < threshold) return ivec2(-1);

    // Normalize direction
    vec2 dir = force / forceMag;

    // Scales probability of force-based movement with magnitude
    float moveChance = clamp((forceMag - threshold) * moveScale, 0.0, 0.95);
    float roll = float(hash3u(uvec2(src), frameCount * 7u + 31u) & 0xFFFFu) / 65535.0;
    if (roll > moveChance) return ivec2(-1);

    int bestDx = int(round(dir.x));
    int bestDy = int(round(dir.y));

    bestDx = clamp(bestDx, -1, 1);
    bestDy = clamp(bestDy, -1, 1);

    if (bestDx == 0 && bestDy == 0) return ivec2(-1);

    ivec2 primary = src + ivec2(bestDx, bestDy);

    if (inBounds(primary)) {
        uint targetElem = getElement(primary);
        if (targetElem == EMPTY) return primary;

        if (forceMag > threshold * 2.0 && targetElem != VOID && targetElem != BLACKHOLE) {
            if (targetElem != elem) {
                // Only force-push into fluids/gases or lighter elements
                bool targetIsFluid = isLiquid(targetElem) || isGas(targetElem);
                bool densityAdv = (elements[elem].density > elements[targetElem].density);
                if (targetIsFluid || densityAdv) {
                    return primary;
                }
            }
        }
        if (canDisplace(elem, targetElem)) return primary;
    }

    ivec2 alt1 = src + ivec2(bestDx, 0);
    ivec2 alt2 = src + ivec2(0, bestDy);

    if (bestDx != 0 && inBounds(alt1) && canDisplace(elem, getElement(alt1))) {
        return alt1;
    }
    if (bestDy != 0 && inBounds(alt2) && canDisplace(elem, getElement(alt2))) {
        return alt2;
    }

    return ivec2(-1);
}

ivec2 desiredDest(ivec2 src, uint elem) {
    vec2 force = getForce(src);
    if (elem != VOID && elem != BLACKHOLE) {
        ivec2 forceDest = forceBasedDest(src, elem, force);
        if (forceDest.x >= 0) return forceDest;
    }

    if (isStatic(elem)) return src;

    int type = elements[elem].type;
    ivec2 down  = src + ivec2(0, -1);
    ivec2 downL = src + ivec2(-1, -1);
    ivec2 downR = src + ivec2(1, -1);
    ivec2 left  = src + ivec2(-1, 0);
    ivec2 right = src + ivec2(1, 0);
    ivec2 up    = src + ivec2(0, 1);
    ivec2 upL   = src + ivec2(-1, 1);
    ivec2 upR   = src + ivec2(1, 1);

    bool leftFirst = (hash2u(uvec2(src) ^ uvec2(frameCount)) & 1u) == 0u;

    // element drift
    if (type == TYPE_GRANULAR) {
        float density = elements[elem].density;
        float elemMass = elements[elem].mass;

        // Only apply drift to elements that are actively falling
        if (canDisplace(elem, getElement(down))) {
            // Mass-based drift: low mass = more horizontal scatter
            float driftChance = clamp(3.0 / max(density, 0.5), 0.02, 0.5);
            driftChance *= clamp(1.0 / max(elemMass, 0.01), 0.5, 10.0);
            driftChance = clamp(driftChance, 0.02, 0.95);

            float roll = float(hash3u(uvec2(src), frameCount) & 0xFFFFu) / 65535.0;
            if (roll < driftChance) {
                if (leftFirst) {
                    if (canDisplace(elem, getElement(downL))) return downL;
                    if (canDisplace(elem, getElement(downR))) return downR;
                }
                else {
                    if (canDisplace(elem, getElement(downR))) return downR;
                    if (canDisplace(elem, getElement(downL))) return downL;
                }
            }
            return down;
        }
        if (leftFirst) {
            if (canDisplace(elem, getElement(downL))) return downL;
            if (canDisplace(elem, getElement(downR))) return downR;
        }
        else {
            if (canDisplace(elem, getElement(downR))) return downR;
            if (canDisplace(elem, getElement(downL))) return downL;
        }
    }
    // LIQUID
    else if (type == TYPE_LIQUID) {
        if (canDisplace(elem, getElement(down))) return down;

        // Viscosity check
        if (random01(src) < elements[elem].viscosity) return src;

        if (leftFirst) {
            if (canDisplace(elem, getElement(downL))) return downL;
            if (canDisplace(elem, getElement(downR))) return downR;
            if (canDisplace(elem, getElement(left))) return left;
            if (canDisplace(elem, getElement(right))) return right;
        }
        else {
            if (canDisplace(elem, getElement(downR))) return downR;
            if (canDisplace(elem, getElement(downL))) return downL;
            if (canDisplace(elem, getElement(right))) return right;
            if (canDisplace(elem, getElement(left))) return left;
        }
    }
    // GAS
    else if (type == TYPE_GAS) {
        if (getElement(up) == EMPTY) return up;
        if (leftFirst) {
            if (getElement(upL) == EMPTY) return upL;
            if (getElement(upR) == EMPTY) return upR;
            if (getElement(left) == EMPTY) return left;
            if (getElement(right) == EMPTY) return right;
        }
        else {
            if (getElement(upR) == EMPTY) return upR;
            if (getElement(upL) == EMPTY) return upL;
            if (getElement(right) == EMPTY) return right;
            if (getElement(left) == EMPTY) return left;
        }
    }

    return src;
}

bool sourceProposesTo(ivec2 src, ivec2 dest) {
    if (!inBounds(src)) return false;

    if (isDoomed(src)) return false;

    // Don't allow proposals to move into a growing sapling
    if (inBounds(dest)) {
        uvec4 destState = getState(dest);
        if (destState.r == SAPLING && destState.b > 0u) return false;
    }

    uint e = getElement(src);
    if (e == EMPTY) return false;

    if (e == VOID || e == BLACKHOLE) return false;

    ivec2 d = desiredDest(src, e);
    if (d != dest) return false;

    // Check if displacement is valid
    uint destElem = getElement(dest);
    if (canDisplace(e, destElem)) return true;

    // Force override: strong force can push into occupied cells (with density check)
    if (destElem != VOID && destElem != BLACKHOLE && destElem != e) {
        vec2 force = getForce(src);
        if (length(force) > 5.0) {
            bool targetIsFluid = isLiquid(destElem) || isGas(destElem) || isEmpty(destElem);
            bool densityAdvantage = (elements[e].density > elements[destElem].density);
            if (targetIsFluid || densityAdvantage) return true;
        }
    }

    return false;
}

ivec2 pickWinnerForDest(ivec2 dest) {
    ivec2 best = ivec2(999999);
    uint bestScore = 0u;
    bool found = false;

    // Check neighbors
    for (int oy = -1; oy <= 1; ++oy) {
        for (int ox = -1; ox <= 1; ++ox) {
            if (ox == 0 && oy == 0) continue;
            ivec2 src = dest + ivec2(ox, oy);
            if (sourceProposesTo(src, dest)) {
                uint score = hash2u(uvec2(src) ^ uvec2(dest) ^ uvec2(frameCount));
                if (!found || score > bestScore) {
                    found = true;
                    bestScore = score;
                    best = src;
                }
            }
        }
    }
    return found ? best : ivec2(999999);
}

bool isTouchingSoil(ivec2 pos) {
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            ivec2 np = pos + ivec2(dx, dy);
            if (inBounds(np)) {
                uint e = getElement(np);
                if (e == DIRT || e == GRASS) return true;
            }
        }
    }
    return false;
}

// Check if this EMPTY cell should become a WOODTIP by pulling from a neighbor
bool tryPullWoodTip(ivec2 pos, out uvec4 newState) {
    ivec2 below = pos + ivec2(0, -1);
    if (!inBounds(below)) return false;

    uvec4 belowState = getState(below);

    if (belowState.r == WOODTIP) {
        uint energy = belowState.g;
        uint branchSeed = belowState.b;

        if (energy > 0u) {
            // Continue growing upward; become the new tip
            newState = uvec4(WOODTIP, energy - 1u, branchSeed, 0u);
            return true;
        } else {
            // become a leaf tip to start canopy
            newState = uvec4(LEAFTIP, 8u, branchSeed, 0u);
            return true;
        }
    }

    // Pull from SAPLING that just initialized
    if (belowState.r == SAPLING && belowState.b >= 1u) {
        uint targetHeight = belowState.g;
        uint growthStep = belowState.b;

        // Only the cell directly above the sapling pulls
        if (growthStep == 1u) {
            uint seed = hash2u(uvec2(below));
            newState = uvec4(WOODTIP, targetHeight - 1u, seed & 0xFFu, 0u);
            return true;
        }
    }

    return false;
}

// Check if this EMPTY cell should become a branch WOODTIP or LEAFTIP
bool tryPullBranch(ivec2 pos, out uvec4 newState) {
    // Check diagonal-below neighbors for branching tips
    for (int dx = -1; dx <= 1; dx += 2) {
        ivec2 diagBelow = pos + ivec2(dx, -1);
        if (!inBounds(diagBelow)) continue;

        uvec4 nState = getState(diagBelow);
        if (nState.r != WOODTIP) continue;

        uint energy = nState.g;
        uint branchSeed = nState.b;

        // Roll for branch chance
        float branchRoll = float(hash3u(uvec2(diagBelow), frameCount * 37u + uint(dx)) & 0xFFFFu) / 65535.0;

        // Branch more in the middle of growth
        float energyRatio = float(energy) / 25.0; // normalized rough estimate
        float branchChance = 0.0;
        if (energyRatio > 0.15 && energyRatio < 0.85) {
            float midFactor = 1.0 - abs(energyRatio - 0.5) * 2.5;
            branchChance = clamp(midFactor * 0.25, 0.05, 0.20);
        }

        if (branchRoll < branchChance && energy > 3u) {
            // Start a branch
            uint branchLen = 2u + (hash3u(uvec2(pos), frameCount + 99u) % 3u);
            newState = uvec4(LEAFTIP, branchLen, branchSeed ^ uint(dx + 2), 0u);
            return true;
        }
    }

    return false;
}

// Check if this EMPTY cell should pull a LEAFTIP from a neighbor
bool tryPullLeafTip(ivec2 pos, out uvec4 newState) {
    // Leaf tips spread outward and upward
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            ivec2 nPos = pos + ivec2(dx, dy);
            if (!inBounds(nPos)) continue;

            uvec4 nState = getState(nPos);
            if (nState.r != LEAFTIP) continue;

            uint energy = nState.g;
            uint dirSeed = nState.b;

            if (energy == 0u) continue;

            // Leaf tips prefer to spread outward/upward
            // Use dirSeed to determine preferred direction
            float spreadRoll = float(hash3u(uvec2(pos), frameCount * 71u + uint(dx * 3 + dy)) & 0xFFFFu) / 65535.0;

            // Higher spread chance for upward/sideways, lower for downward
            float spreadChance = (dy >= 0) ? 0.35 : 0.10;

            if (spreadRoll < spreadChance) {
                newState = uvec4(LEAFTIP, energy - 1u, dirSeed ^ hash3u(uvec2(pos), 123u), 0u);
                return true;
            }
        }
    }

    return false;
}

void main() {
    ivec2 pos;

    if (useChunkSleep) {
        // Derive pixel position from the active chunk list
        uint chunkId = active_chunk_ids[gl_WorkGroupID.x];
        ivec2 chunkCoord = ivec2(int(chunkId % CHUNK_GRID_W), int(chunkId / CHUNK_GRID_W));
        pos = chunkCoord * CHUNK_SIZE + ivec2(gl_LocalInvocationID.xy);
    } else {
        pos = ivec2(gl_GlobalInvocationID.xy);
    }

    if (!inBounds(pos)) return;

    // Pre-load current state for displacement protection checks
    uvec4 cur = getState(pos);
    uint elem = cur.r;
    uint life = cur.g;

    // Check if anything is moving into us.
    bool isAnchored = (elem == SAPLING && cur.b > 0u); // Growing sapling

    ivec2 winner = pickWinnerForDest(pos);
    if (winner.x != 999999 && !isAnchored) {
        uvec4 winState = getState(winner);
        imageStore(stateOut, pos, winState);
        // Something moved here - wake this chunk for next frame
        wakeChunkAndNeighbors(pos);
        return; // We have been overwritten. Stop.
    }

    // Boundary sentinel check
    if (elem >= MAX_ELEMENTS) {
        imageStore(stateOut, pos, cur);
        return;
    }

    // Phase 1: BLACK HOLE emits effector for scatter-based physics
    if (elem == BLACKHOLE) {
        emitEffector(vec2(pos), 0u, 8.0); // type 0 = Black Hole
    }

    // VOID: Destroy anything touching it
    if (elem != VOID && elem != BLACKHOLE && elem != EMPTY) {
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                if (dx == 0 && dy == 0) continue;
                uint neighbor = getElement(pos + ivec2(dx, dy));
                if (neighbor == VOID) {
                    imageStore(stateOut, pos, uvec4(EMPTY, 0u, 0u, 0u));
                    wakeChunkAndNeighbors(pos);
                    return;
                }
            }
        }
    }

    // BLACK HOLE: Destroy anything touching it
    if (elem != VOID && elem != BLACKHOLE && elem != EMPTY) {
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) {
                if (dx == 0 && dy == 0) continue;
                uint neighbor = getElement(pos + ivec2(dx, dy));
                if (neighbor == BLACKHOLE) {
                    imageStore(stateOut, pos, uvec4(EMPTY, 0u, 0u, 0u));
                    wakeChunkAndNeighbors(pos);
                    return;
                }
            }
        }
    }

    // BOMB LOGIC
    if (elem == BOMB) {
        uint fuse = cur.g;
        uint flags = cur.b;

        // If this is the detonation frame (B=255), turn into fire + smoke
        if (flags == 255u) {
            // Phase 1: Emit bomb effector for scatter-based physics
            emitEffector(vec2(pos), 1u, 15.0); // type 1 = Bomb

            // Bomb center becomes fire
            imageStore(stateOut, pos, uvec4(FIRE, 255u, 0u, 0u));
            wakeChunkAndNeighbors(pos);
            return;
        }

        // Check if bomb has landed
        ivec2 below = pos + ivec2(0, -1);
        bool resting = !inBounds(below) || !canDisplace(elem, getElement(below));

        if (resting) {
            fuse++;

            if (fuse >= BOMB_FUSE_TICKS) {
                int destroyR = int(BOMB_DESTROY_RADIUS);
                imageStore(stateOut, pos, uvec4(BOMB, 0u, 255u, 0u));
                // Wake a large area for the explosion
                for (int wdy = -1; wdy <= 1; wdy++) {
                    for (int wdx = -1; wdx <= 1; wdx++) {
                        wakeChunk(pos + ivec2(wdx * CHUNK_SIZE, wdy * CHUNK_SIZE));
                    }
                }
                return;
            }

            imageStore(stateOut, pos, uvec4(BOMB, fuse, 0u, 0u));
            wakeChunkAndNeighbors(pos);
            return;
        }
    }

    // BOMB DESTRUCTION CHECK
    if (elem != EMPTY && elem != BOMB && !isIndestructible(elem)) {
        int destroyR = int(BOMB_DESTROY_RADIUS);
        for (int dy = -destroyR; dy <= destroyR; dy++) {
            for (int dx = -destroyR; dx <= destroyR; dx++) {
                ivec2 sp = pos + ivec2(dx, dy);
                if (!inBounds(sp)) continue;
                uvec4 sState = getState(sp);
                if (sState.r == BOMB && sState.b == 255u) {
                    float dist = length(vec2(dx, dy));
                    if (dist <= BOMB_DESTROY_RADIUS) {
                        // Close things get destroyed, farther out is chance based
                        float destroyChance = 1.0 - (dist / BOMB_DESTROY_RADIUS);
                        destroyChance = destroyChance * destroyChance;
                        float roll = float(hash3u(uvec2(pos), frameCount + 777u) & 0xFFFFu) / 65535.0;
                        if (roll < destroyChance) {
                            if (isFlammable(elem)) {
                                imageStore(stateOut, pos, uvec4(FIRE, 255u, 0u, 0u));
                            }
                            else {
                                if (dist < BOMB_DESTROY_RADIUS * 0.4) {
                                    imageStore(stateOut, pos, uvec4(EMPTY, 0u, 0u, 0u));
                                }
                                else {
                                    imageStore(stateOut, pos, uvec4(SMOKE, 180u, 0u, 0u));
                                }
                            }
                            wakeChunkAndNeighbors(pos);
                            return;
                        }
                    }
                }
            }
        }
    }

   // === MIGRATED HARDCODED INTERACTIONS ===
       if (elem != EMPTY && elem < MAX_ELEMENTS) {
           bool touchingFire = false;
           bool touchingWater = false;
           int steamCount = 0;

           // Scan neighbors once
           for (int dy = -1; dy <= 1; dy++) {
               for (int dx = -1; dx <= 1; dx++) {
                   if (dx == 0 && dy == 0) continue;
                   ivec2 np = pos + ivec2(dx, dy);
                   if (!inBounds(np)) continue;

                   uint nElem = getElement(np);
                   if (nElem == FIRE || nElem == LAVA) touchingFire = true;
                   if (nElem == WATER) touchingWater = true;
                   if (nElem == STEAM || nElem == CLOUD) steamCount++;
               }
           }

           float roll = float(hash3u(uvec2(pos), frameCount * 13u + 7u) & 0xFFFFu) / 65535.0;

           // Phase Changes
           if (elem == ICE) {
               if (touchingFire || roll < 0.002 * globalEntropy) { // Melts near fire or slowly at ambient
                   imageStore(stateOut, pos, uvec4(WATER, 0u, 0u, 0u));
                   wakeChunkAndNeighbors(pos); return;
               }
           }
           else if (elem == WATER && touchingFire) {
               if (roll < 0.15) { // Boils to steam
                   imageStore(stateOut, pos, uvec4(STEAM, 255u, 0u, 0u));
                   wakeChunkAndNeighbors(pos); return;
               }
           }
           else if (elem == LAVA && touchingWater) {
               if (roll < 0.8) { // Cools to obsidian
                   imageStore(stateOut, pos, uvec4(OBSIDIAN, 0u, 0u, 0u));
                   wakeChunkAndNeighbors(pos); return;
               }
           }
           else if (elem == THERMITE && touchingFire) { // Ignites to molten iron
               imageStore(stateOut, pos, uvec4(MOLTENIRON, 0u, 0u, 0u));
               wakeChunkAndNeighbors(pos); return;
           }
           else if (elem == MOLTENIRON) { // Cools to obsidian
               if (touchingWater || roll < 0.005) {
                   imageStore(stateOut, pos, uvec4(OBSIDIAN, 0u, 0u, 0u));
                   wakeChunkAndNeighbors(pos); return;
               }
           }
           else if (elem == LIQUIDNITROGEN) { // Boils to N2
               if (roll < 0.05 * globalEntropy) {
                   imageStore(stateOut, pos, uvec4(N2GAS, 150u, 0u, 0u));
                   wakeChunkAndNeighbors(pos); return;
               }
           }
           else if (elem == DRYICE) { // Sublimates to CO2
               if (roll < 0.02 * globalEntropy) {
                   imageStore(stateOut, pos, uvec4(CO2GAS, 180u, 0u, 0u));
                   wakeChunkAndNeighbors(pos); return;
               }
           }
           else if (elem == STEAM) { // Condenses to cloud
               if (steamCount >= 6 && roll < 0.08 * globalEntropy) {
                   imageStore(stateOut, pos, uvec4(CLOUD, 255u, 0, 0));
                   wakeChunkAndNeighbors(pos); return;
               }
               wakeChunkAndNeighbors(pos); // Keep awake
           }
           else if (elem == CLOUD) { // Cloud decay & rain (Kept from original logic)
               ivec2 below = pos + ivec2(0, -1);
               if (inBounds(below) && getElement(below) == EMPTY) {
                   float rainChance = 0.008 * globalEntropy;
                   if (roll < rainChance && life > 10u) cur.g = life - 5u;
               }
               uint cloudDecay = 1u;
               uint randDecay = hash3u(uvec2(pos), frameCount * 41u) % 3u;
               if (randDecay == 0u) {
                   if (life <= cloudDecay) {
                       imageStore(stateOut, pos, uvec4(EMPTY, 0u, 0u, 0u));
                       wakeChunkAndNeighbors(pos); return;
                   }
                   cur.g = life - cloudDecay;
               }
               wakeChunkAndNeighbors(pos);
           }
           else if (elem == FUSER) { // Fuser melts/burns neighbors
               for (int dy = -1; dy <= 1; dy++) {
                   for (int dx = -1; dx <= 1; dx++) {
                       ivec2 np = pos + ivec2(dx, dy);
                       if (!inBounds(np)) continue;
                       uint nElem = getElement(np);
                       if (nElem == SAND || nElem == STONE || nElem == OBSIDIAN) {
                           if (random01(np) < 0.05) {
                               imageStore(stateOut, np, uvec4(LAVA, 0u, 0u, 0u));
                               wakeChunkAndNeighbors(np);
                           }
                       } else if (isFlammable(nElem)) {
                           if (random01(np) < 0.1) {
                               imageStore(stateOut, np, uvec4(FIRE, 255u, 0u, 0u));
                               wakeChunkAndNeighbors(np);
                           }
                       }
                   }
               }
               wakeChunkAndNeighbors(pos);
           }
       }

    // REACTION LOGIC
    // (Contact reactions removed - now handled by data-driven thermal system)
    // SMOKE DECAY
    if (elem == SMOKE) {
        if (life == 0u) {
            imageStore(stateOut, pos, uvec4(EMPTY, 0u, 0u, 0u));
            wakeChunkAndNeighbors(pos);
            return;
        }
        uint baseDecay = 3u;
        uint randDecay = hash3u(uvec2(pos), frameCount) % 5u;
        uint totalDecay = baseDecay + randDecay;

        if (life <= totalDecay) {
            imageStore(stateOut, pos, uvec4(EMPTY, 0u, 0u, 0u));
            wakeChunkAndNeighbors(pos);
            return;
        }
        cur.g = life - totalDecay;
        // Smoke is decaying, stay awake
        wakeChunkAndNeighbors(pos);
    }

    // Generic Life Decay
    if (elem != SMOKE && elem != BOMB && hasLife(elem) && life > 0u) {
        uint decayRate = 4u;
        if (life <= decayRate) {
            uint deathElem;
            uint deathLife;
            if (elem == FIRE) {
                deathElem = SMOKE;
                deathLife = 180u + (hash3u(uvec2(pos), frameCount) % 40u);
            }
            else {
                deathElem = EMPTY;
                deathLife = 0u;
            }
            imageStore(stateOut, pos, uvec4(deathElem, deathLife, 0, 0));
            wakeChunkAndNeighbors(pos);
            return;
        }
        cur.g = life - decayRate;
        wakeChunkAndNeighbors(pos);
    }

    // FLAMMABILITY
    if (isFlammable(elem)) {
        bool touchingFire = false;
        for(int dy = -1; dy <= 1; dy++) {
            for(int dx = -1; dx <= 1; dx++) {
                uint n = getElement(pos + ivec2(dx, dy));
                if (n == FIRE || n == LAVA) touchingFire = true;
            }
        }
        if (touchingFire && random01(pos) < elements[elem].probability) {
            if (elem == GRASS) {
                imageStore(stateOut, pos, uvec4(DIRT, 0u, 0u, 0u));
            }
            else {
                imageStore(stateOut, pos, uvec4(FIRE, 255u, 0, 0));
            }
            wakeChunkAndNeighbors(pos);
            return;
        }
    }

    // SEED -> GRASS Logic
    if (elem == SEED) {
        ivec2 below = pos + ivec2(0, -1);
        bool resting = !inBounds(below) || !canDisplace(elem, getElement(below));

        if (resting) {
            bool touchingSoil = false;
            for (int dy = -1; dy <= 1; dy++) {
                for (int dx = -1; dx <= 1; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    ivec2 np = pos + ivec2(dx, dy);
                    if (inBounds(np)) {
                        uint ne = getElement(np);
                        if (ne == DIRT || ne == GRASS) {
                            touchingSoil = true;
                        }
                    }
                }
            }
            if (touchingSoil) {
                imageStore(stateOut, pos, uvec4(GRASS, 255u, 0, 0));
                wakeChunkAndNeighbors(pos);
                return;
            }
        }
    }

    // GRASS Spreading
    if (elem == DIRT) {
        ivec2 dirs[8] = ivec2[8](
            ivec2(1,0), ivec2(-1,0), ivec2(0,-1), ivec2(0,1),
            ivec2(1,1), ivec2(-1,1), ivec2(1,-1), ivec2(-1,-1)
        );

        int startIdx = int(random01b(pos) * 8.0);

        for (int i = 0; i < 8; i++) {
            int idx = (startIdx + i) % 8;
            ivec2 neighborPos = pos + dirs[idx];

            if (inBounds(neighborPos)) {
                uvec4 nState = getState(neighborPos);
                uint nElem = nState.r;
                uint nLife = nState.g;

                if (nElem == GRASS && nLife > 30u) {
                    ivec2 belowNeighbor = neighborPos + ivec2(0, -1);
                    bool isSettled = !inBounds(belowNeighbor) || !canDisplace(GRASS, getElement(belowNeighbor));

                    if (isSettled) {
                        float spreadChance = (float(nLife) / 255.0) * 0.10;
                        if (random01(pos) < spreadChance) {
                            uint newLife = nLife - 20u;
                            if (newLife < 30u) newLife = 30u;

                            imageStore(stateOut, pos, uvec4(GRASS, newLife, 0, 0));
                            wakeChunkAndNeighbors(pos);
                            return;
                        }
                    }
                }
            }
        }
    }

    // SAPLING
    if (elem == SAPLING) {
        uint targetHeight = cur.g;
        uint growthStep = cur.b;

        if (growthStep == 0u) {
            // Initialize growth.
            if (isTouchingSoil(pos)) {
                uint treeHeight = hash2u(uvec2(pos)) % 14u + 12u;
                imageStore(stateOut, pos, uvec4(SAPLING, treeHeight, 1u, 0u));
                wakeChunkAndNeighbors(pos);
                return;
            }
        }
        else {
            // Check if there's still a tip directly above
            ivec2 above = pos + ivec2(0, 1);
            uvec4 aboveState = getState(above);

            if (aboveState.r == WOODTIP || aboveState.r == WOOD || growthStep > 1u) {
                imageStore(stateOut, pos, uvec4(WOOD, 0u, 0u, 0u));
                return;
            }

            // Keep waiting
            imageStore(stateOut, pos, cur);
            wakeChunkAndNeighbors(pos);
            return;
        }
    }

    // WOODTIP
    if (elem == WOODTIP) {
        imageStore(stateOut, pos, uvec4(WOOD, 0u, 0u, 0u));
        wakeChunkAndNeighbors(pos);
        return;
    }

    // LEAFTIP
    if (elem == LEAFTIP) {
        imageStore(stateOut, pos, uvec4(PLANT, 255u, 0u, 0u));
        wakeChunkAndNeighbors(pos);
        return;
    }

    // EMPTY CELL
    if (elem == EMPTY) {
        // Cloud rain: check if there's a cloud above that wants to rain
        ivec2 above = pos + ivec2(0, 1);
        if (inBounds(above)) {
            uvec4 aboveState = getState(above);
            if (aboveState.r == CLOUD && aboveState.g > 15u) {
                float rainRoll = float(hash3u(uvec2(pos), frameCount * 43u + 29u) & 0xFFFFu) / 65535.0;
                if (rainRoll < 0.006) {
                    imageStore(stateOut, pos, uvec4(WATER, 0u, 0u, 0u));
                    wakeChunkAndNeighbors(pos);
                    return;
                }
            }
        }

        uvec4 newState;

        if (tryPullWoodTip(pos, newState)) {
            imageStore(stateOut, pos, newState);
            wakeChunkAndNeighbors(pos);
            return;
        }

        if (tryPullBranch(pos, newState)) {
            imageStore(stateOut, pos, newState);
            wakeChunkAndNeighbors(pos);
            return;
        }

        if (tryPullLeafTip(pos, newState)) {
            imageStore(stateOut, pos, newState);
            wakeChunkAndNeighbors(pos);
            return;
        }
    }

    // MOVEMENT

    // Otherwise, try to move
    if (!isEmpty(elem) && (elem != VOID && elem != BLACKHOLE)) {
        ivec2 dest = desiredDest(pos, elem);
        if (dest != pos) {
            uint destElem = getElement(dest);
            // Check if we can actually go there
            bool canGo = canDisplace(elem, destElem);
            // Force can push into occupied cells too, but only if target is
            // a fluid/gas or lower density — prevents Y-column crush bug
            if (!canGo && destElem != VOID && destElem != BLACKHOLE) {
                vec2 force = getForce(pos);
                float forceMag = length(force);
                if (forceMag > 5.0 && destElem != elem) {
                    // Only allow force override against non-static, non-granular
                    // OR if target density is less than ours
                    bool targetIsFluid = isLiquid(destElem) || isGas(destElem) || isEmpty(destElem);
                    bool densityAdvantage = (elements[elem].density > elements[destElem].density);
                    if (targetIsFluid || densityAdvantage) {
                        canGo = true; // Force override
                    }
                }
            }
            if (canGo) {
                ivec2 w = pickWinnerForDest(dest);
                if (w == pos) {
                    // We moved. Get what we displaced
                    uvec4 displaced = getState(dest);
                    uint dispElem = displaced.r;

                    // prevent force-override duplication cascades
                    if (dispElem != EMPTY && !isImmobile(dispElem)) {
                        ivec2 dispDest = desiredDest(dest, dispElem);

                        // If the element we are displacing won a move to somewhere else
                        if (dispDest != dest) {
                            ivec2 dispWinner = pickWinnerForDest(dispDest);
                            if (dispWinner == dest) {
                                // Don't clone it back into our old spot.
                                displaced = uvec4(EMPTY, 0u, 0u, 0u);
                            }
                        }

                        // mutual diagonal swap prevention
                        if (dispDest == pos) {
                            imageStore(stateOut, pos, uvec4(EMPTY, 0u, 0u, 0u));
                            wakeChunkAndNeighbors(pos);
                            return;
                        }
                    }

                    imageStore(stateOut, pos, displaced);
                    // We moved - wake both source and destination chunks
                    wakeChunkAndNeighbors(pos);
                    wakeChunkAndNeighbors(dest);
                    return;
                }
            }
        }
    }

    // Nothing happened - write current state unchanged
    if (!isEmpty(elem) && !isStatic(elem)) {
        if (isGranular(elem)) {
            // If sand is resting on something it cannot displace, let it sleep
            ivec2 below = pos + ivec2(0, -1);
            if (inBounds(below) && canDisplace(elem, getElement(below))) {
                wakeChunkAndNeighbors(pos); // Still falling
            }
        } else {
            // Liquids, gases, and spreading elements stay awake to evaluate randomness
            wakeChunkAndNeighbors(pos);
        }
    }

    imageStore(stateOut, pos, cur);
}