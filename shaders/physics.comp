#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

// Force field: RG = force vector (x, y), BA = metadata (magnitude hint, age/flags)
layout(rgba16f, binding = 0) uniform readonly  image2D forceIn;
layout(rgba16f, binding = 1) uniform writeonly image2D forceOut;
layout(rgba8ui, binding = 2) uniform readonly  uimage2D stateIn;

struct ElementData {
    vec4 color;                // 0-15
    int type;                  // 16-19
    float density;             // 20-23
    float viscosity;           // 24-27
    int glow;                  // 28-31
    int gemstone;              // 32-35
    float lightRadius;         // 36-39
    float lightIntensity;      // 40-43
    float ior;                 // 44-47
    float opacity;             // 48-51
    float specularPower;       // 52-55
    int _pad1, _pad2;          // 56-63
    vec4 transmissionTint;     // 64-79
    float baseHeight;          // 80-83
    float colorVariation;      // 84-87
    int animType;              // 88-91
    float mass;                // 92-95
};

layout(std430, binding = 2) buffer ElementRegistry {
    ElementData elements[];
};

// Phase 1: Effector List SSBO (scatter approach)
struct Effector {
    vec2 position;       // 8 bytes
    uint type;           // 4 bytes (0 = Black Hole, 1 = Bomb)
    float strength;      // 4 bytes
};

layout(std430, binding = 3) buffer EffectorList {
    uint effectorCount;
    uint _pad1;
    uint _pad2;
    uint _pad3;
    Effector effectors[];
};

uniform vec2  worldSize;
uniform float time;
uniform uint  frameCount;

const float FORCE_DECAY     = 0.82;   // How quickly forces fade per step
const float FORCE_SPREAD    = 0.20;   // How much force spreads to neighbors
const float BLACK_HOLE_PULL = 8.0;    // Attraction strength
const float BLACK_HOLE_RANGE = 30.0;  // Attraction radius in pixels
const float BOMB_FORCE      = 15.0;   // Explosion impulse strength
const float BOMB_RADIUS     = 20.0;   // Explosion radius

bool inBounds(ivec2 p) {
    return (p.x >= 0 && p.x < int(worldSize.x) &&
            p.y >= 0 && p.y < int(worldSize.y));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (!inBounds(pos)) return;

    vec4 curForce = imageLoad(forceIn, pos);
    vec2 force = curForce.rg;

    uvec4 state = imageLoad(stateIn, pos);
    uint elem = state.r;

    // Decay existing forces
    force *= FORCE_DECAY;

    // Kill very small forces
    if (length(force) < 0.01) force = vec2(0.0);

    // Spread forces from neighbors
    vec2 neighborForce = vec2(0.0);
    float totalWeight = 0.0;

    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            ivec2 np = pos + ivec2(dx, dy);
            if (!inBounds(np)) continue;

            vec4 nf = imageLoad(forceIn, np);
            float w = (abs(dx) + abs(dy) == 1) ? 1.0 : 0.707; // Cardinal vs diagonal
            neighborForce += nf.rg * w;
            totalWeight += w;
        }
    }

    if (totalWeight > 0.0) {
        neighborForce /= totalWeight;
        // Blend: keep most of our own force, add a bit of neighbor average
        force = mix(force, neighborForce, FORCE_SPREAD);
    }

    // Phase 1: Iterate over the effector list (scatter approach)
    // This replaces the old spatial scanning loops for black holes and bombs
    uint count = min(effectorCount, uint(MAX_EFFECTORS));
    for (uint i = 0u; i < count; i++) {
        Effector eff = effectors[i];
        vec2 toEffector = eff.position - vec2(pos);
        float dist = length(toEffector);

        if (eff.type == 0u) {
            // Black Hole: attraction force
            if (dist < 1.0 || dist > BLACK_HOLE_RANGE) continue;

            vec2 dir = normalize(toEffector);
            float strength = BLACK_HOLE_PULL / (dist * dist) * BLACK_HOLE_RANGE;
            force += dir * strength;
        }
        else if (eff.type == 1u) {
            // Bomb: explosion impulse (push away)
            if (dist < 0.5 || dist > BOMB_RADIUS) continue;

            vec2 dir = normalize(-toEffector); // Away from bomb
            float falloff = 1.0 - (dist / BOMB_RADIUS);
            falloff = falloff * falloff; // Quadratic falloff
            force += dir * BOMB_FORCE * falloff;
        }

        // FAN LOGIC
        else if (eff.type >= 2u && eff.type <= 5u) {
            float fanLength = 125.0;  // how far the beam reaches
            float fanWidth  = 3.0;   // half-width of the beam (perpendicular spread)

            vec2 dir;
            if      (eff.type == 2u) dir = vec2(-1.0, 0.0);  // Left
            else if (eff.type == 3u) dir = vec2( 1.0, 0.0);  // Right
            else if (eff.type == 4u) dir = vec2( 0.0, 1.0);  // Up
            else                     dir = vec2( 0.0,-1.0);  // Down

            // Project the offset onto the fan direction
            vec2 offset = vec2(pos) - eff.position;
            float along = dot(offset, dir);        // distance along beam
            float perp  = abs(dot(offset, vec2(-dir.y, dir.x)));  // perpendicular distance

            // Only affect cells in front of the fan, within the beam width
            if (along > 0.0 && along < fanLength && perp < fanWidth) {
                float falloff = 1.0 - (along / fanLength);
                falloff *= 1.0 - (perp / fanWidth);  // fade at edges
                falloff = max(falloff, 0.0);
                float strength = eff.strength * falloff * falloff;
                force += dir * strength;
            }
        }
    }

    // Static elements partially absorb force
    if (elem < MAX_ELEMENTS && elem != EMPTY) {
        int type = elements[elem].type;
        // Static elements absorb some force but not all
        if (type == 0 && elem != VOID && elem != BLACKHOLE) {
            force = vec2(0.0);
        }
    }

    // Clamp max force to prevent instability
    float maxForce = 20.0;
    if (length(force) > maxForce) {
        force = normalize(force) * maxForce;
    }

    imageStore(forceOut, pos, vec4(force, 0.0, 0.0));
}
