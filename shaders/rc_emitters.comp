#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8ui, binding = 0) uniform readonly  uimage2D stateIn;
layout(rgba16f, binding = 1) uniform writeonly image2D  radianceField;

struct ElementData {
    vec4 color;                // 0-15
    int type;                  // 16-19
    float density;             // 20-23
    float viscosity;           // 24-27
    float probability;         // 28-31
    int flammability;          // 32-35
    int glow;                  // 36-39
    int maxLife;               // 40-43
    int gemstone;              // 44-47
    float lightRadius;         // 48-51
    float lightIntensity;      // 52-55
    float ior;                 // 56-59
    float opacity;             // 60-63
    float specularPower;       // 64-67
    int _pad1, _pad2, _pad3;   // 68-79
    vec4 transmissionTint;     // 80-95
    float baseHeight;          // 96-99
    float colorVariation;      // 100-103
    int animType;              // 104-107
    float mass;                // 108-111
};

layout(std430, binding = 2) buffer ElementRegistry {
    ElementData elements[];
};

uniform float time;
uniform bool  glowEnabled;
uniform float glowIntensity;
uniform bool  skyEnabled;
uniform float timeOfDay;

// Animation type constants
const int ANIM_NONE      = 0;
const int ANIM_LIQUID    = 1;
const int ANIM_FIRE      = 2;
const int ANIM_VOID      = 3;
const int ANIM_BLACKHOLE = 4;
const int ANIM_RAINBOW   = 5;

float hashNoise(ivec2 pos) {
    return fract(sin(dot(vec2(pos), vec2(12.9898, 78.233))) * 43758.5453);
}

// Phase 3: getOpacity is REMOVED. Opacity is read directly from the element buffer.

void main() {
    ivec2 pos  = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(stateIn);
    if (pos.x >= size.x || pos.y >= size.y) return;

    uvec4 state = imageLoad(stateIn, pos);
    uint  elem  = state.r;

    vec3 emission = vec3(0.0);

    if (glowEnabled && elem != EMPTY && elem < MAX_ELEMENTS) {
        float variation = hashNoise(pos);
        int anim = elements[elem].animType;

        // Light element
        if (elem == LIGHT) {
            float intensity = elements[elem].lightIntensity;
            if (intensity <= 0.0) intensity = 1.5;
            emission = vec3(1.0, 0.98, 0.9) * intensity;
        }
        else if(elem == REDLIGHT || elem == BLUELIGHT || elem == GREENLIGHT || elem == CYANLIGHT || elem == YELLOWLIGHT || elem == MAGENTALIGHT){
            float intensity = elements[elem].lightIntensity;
            if (intensity <= 0.0) intensity = 1.5;
            emission = vec3(elements[elem].transmissionTint.r, elements[elem].transmissionTint.g, elements[elem].transmissionTint.b) * intensity;
        }
        // Phase 3: Fire via animType
        else if (anim == ANIM_FIRE) {
            float flicker = sin(time * 8.0 + variation * 10.0) * 0.3 + 0.7;
            float lifeFactor = float(state.g) / 255.0;
            emission = vec3(1.0, 0.5, 0.15) * flicker * lifeFactor * glowIntensity * 1.2;
        }
        // Lava (hot elements glow based on baseTemperature)
        else if (elem == LAVA) {
            float pulse = sin(time * 3.0 + variation * 6.28) * 0.15 + 0.85;
            emission = vec3(1.0, 0.4, 0.1) * pulse * glowIntensity * 0.8;
        }
        // Phase 3: Black Hole via animType
        else if (anim == ANIM_BLACKHOLE) {
            float ring = sin(time * 4.0 + variation * 6.28) * 0.5 + 0.5;
            vec3 accColor = mix(vec3(0.3, 0.05, 0.5), vec3(0.6, 0.2, 0.05), ring);
            float intensity = elements[elem].lightIntensity;
            if (intensity <= 0.0) intensity = 0.3;
            emission = accColor * intensity;
        }
        // Bomb
        else if (elem == BOMB) {
            float fuseProgress = float(state.g) / 250.0;
            if (fuseProgress > 0.5) {
                emission = vec3(1.0, 0.2, 0.0) * fuseProgress * glowIntensity * 0.8;
            }
        }
        // Rainbow: cycling colored light emission
        else if (anim == ANIM_RAINBOW) {
            float hue = fract(time * 0.15 + float(pos.x + pos.y) * 0.005);
            float c = 1.0;
            float x = c * (1.0 - abs(mod(hue * 6.0, 2.0) - 1.0));
            vec3 rgb;
            if (hue < 1.0/6.0) rgb = vec3(c, x, 0.0);
            else if (hue < 2.0/6.0) rgb = vec3(x, c, 0.0);
            else if (hue < 3.0/6.0) rgb = vec3(0.0, c, x);
            else if (hue < 4.0/6.0) rgb = vec3(0.0, x, c);
            else if (hue < 5.0/6.0) rgb = vec3(x, 0.0, c);
            else rgb = vec3(c, 0.0, x);
            float intensity = elements[elem].lightIntensity;
            if (intensity <= 0.0) intensity = 1.5;
            emission = rgb * intensity;;
        }
        // Generic glow
        else if (elements[elem].glow == 1) {
            emission = elements[elem].color.rgb * glowIntensity * 0.6;
        }
    }

    // Phase 3: Read opacity directly from element buffer (replaces getOpacity function)
    float opacity = 0.0;
    if (elem != EMPTY && elem < MAX_ELEMENTS) {
        opacity = elements[elem].opacity;
    }

    imageStore(radianceField, pos, vec4(emission, opacity));
}
