#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8ui, binding = 0) uniform readonly  uimage2D stateIn;
layout(rgba8,   binding = 1) uniform readonly  image2D  colorIn;
layout(rgba16f, binding = 2) uniform readonly  image2D  normalIn;
layout(rgba16f, binding = 3) uniform readonly  image2D  lightmapIn;
layout(rgba8,   binding = 4) uniform writeonly image2D  displayOut;
layout(rgba8,   binding = 5) uniform readonly  image2D  skyIn;

struct ElementData {
    vec4 color;
    int type;
    float density;
    float viscosity;
    float probability;
    int flammability;
    int glow;
    int maxLife;
    int gemstone;
    float lightRadius;
    float lightIntensity;
    float ior;
    int _pad;
};

layout(std430, binding = 2) buffer ElementRegistry {
    ElementData elements[];
};

uniform float ambientLight;
uniform float specularStrength;
uniform float time;
uniform bool skyEnabled;
uniform float timeOfDay;

// Attempt a soft tonemap: Reinhard with configurable exposure
vec3 tonemap(vec3 color) {
    // Extended Reinhard tonemapping
    vec3 mapped = color / (color + vec3(1.0));
    // sRGB gamma correction
    return pow(mapped, vec3(1.0 / 2.2));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(stateIn);
    if (pos.x >= size.x || pos.y >= size.y) return;

    uvec4 state   = imageLoad(stateIn, pos);
    vec4 color    = imageLoad(colorIn, pos);
    vec4 normData = imageLoad(normalIn, pos);
    vec4 light    = imageLoad(lightmapIn, pos);
    vec4 skyColor = imageLoad(skyIn, pos);

    uint elem = state.r;

    // Empty pixels: show sky/background with any light that passed through
    if (elem == EMPTY) {
        // For empty pixels, the lightmap contains indirect light bouncing around
        // Add it subtly to the sky/background color
        vec3 base = color.rgb;  // Sky or background from render pass
        vec3 indirect = light.rgb;
        vec3 final = base + indirect * 0.3;  // Subtle indirect contribution to empty space
        imageStore(displayOut, pos, vec4(clamp(final, 0.0, 1.0), color.a));
        return;
    }

    // Light element itself — just show it bright
    if (elem == LIGHT) {
        imageStore(displayOut, pos, vec4(color.rgb, 1.0));
        return;
    }

    vec3 normal = normData.xyz;
    float specPower = normData.w;
    vec3 lightColor = light.rgb;

    // Self-emitting elements
    bool isSelfLit = false;
    if (elem < MAX_ELEMENTS) {
        if (elements[elem].glow == 1 || elem == FIRE) {
            isSelfLit = true;
        }
    }

    // Sky-based directional sunlight
    vec3 sunDirection = vec3(0.0, 0.0, 1.0);
    vec3 sunColor = vec3(1.0);
    float sunStrength = 0.0;

    if (skyEnabled) {
        float sunElevation = sin(timeOfDay * 3.14159);
        float sunHoriz = cos(timeOfDay * 3.14159) * 0.5;

        sunDirection = normalize(vec3(sunHoriz, sunElevation * 0.7, 0.8));
        sunStrength = max(sunElevation, 0.0);

        if (sunElevation < 0.3) {
            float t = max(sunElevation, 0.0) / 0.3;
            sunColor = mix(vec3(1.0, 0.5, 0.2), vec3(1.0, 0.95, 0.9), t);
        }
        else {
            sunColor = vec3(1.0, 0.98, 0.92);
        }
    }

    // Diffuse lighting: ambient + RC lightmap contribution
    float normalFactor = normal.z * 0.6 + 0.4;
    vec3 diffuse = color.rgb * (ambientLight + lightColor * normalFactor);

    // Add directional sunlight when sky is enabled
    if (skyEnabled && sunStrength > 0.01) {
        float sunDiffuse = max(dot(normal, sunDirection), 0.0);
        diffuse += color.rgb * sunColor * sunDiffuse * sunStrength * 0.4;
    }

    // Specular highlights
    vec3 specular = vec3(0.0);
    float lightIntensity = length(lightColor);
    if (specPower > 1.0) {
        vec3 viewDir = vec3(0.0, 0.0, 1.0);

        if (lightIntensity > 0.05) {
            ivec2 pR = clamp(pos + ivec2(1, 0), ivec2(0), size - 1);
            ivec2 pL = clamp(pos + ivec2(-1, 0), ivec2(0), size - 1);
            ivec2 pU = clamp(pos + ivec2(0, 1), ivec2(0), size - 1);
            ivec2 pD = clamp(pos + ivec2(0, -1), ivec2(0), size - 1);
            vec3 lightDir = normalize(vec3(
                imageLoad(lightmapIn, pR).r - imageLoad(lightmapIn, pL).r,
                imageLoad(lightmapIn, pU).r - imageLoad(lightmapIn, pD).r,
                0.5
            ));

            vec3 halfDir = normalize(lightDir + viewDir);
            float spec = pow(max(dot(normal, halfDir), 0.0), specPower);
            specular += lightColor * spec * specularStrength;

            // Gemstone dispersion
            if (elem < MAX_ELEMENTS && elements[elem].gemstone == 1) {
                float angle = dot(normal.xy, lightDir.xy);
                vec3 dispersion = vec3(
                    spec * (1.0 + angle * 0.3),
                    spec,
                    spec * (1.0 - angle * 0.3)
                );
                specular = lightColor * dispersion * specularStrength * 1.5;
            }
        }

        // Sun specular
        if (skyEnabled && sunStrength > 0.05) {
            vec3 sunHalf = normalize(sunDirection + viewDir);
            float sunSpec = pow(max(dot(normal, sunHalf), 0.0), specPower);
            specular += sunColor * sunSpec * specularStrength * sunStrength * 0.5;
        }
    }

    // Self-illumination
    vec3 emission = vec3(0.0);
    if (isSelfLit) {
        emission = color.rgb * 0.6;
    }

    vec3 final = diffuse + specular + emission;

    // Tonemapping: Reinhard + proper sRGB gamma
    final = tonemap(final);

    imageStore(displayOut, pos, vec4(clamp(final, 0.0, 1.0), color.a));
}
