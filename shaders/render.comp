#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba8ui, binding = 0) uniform readonly uimage2D stateIn;
layout(rgba8,   binding = 1) uniform writeonly image2D colorOut;
layout(rgba16f, binding = 2) uniform writeonly image2D normalOut;
layout(rgba8,   binding = 5) uniform writeonly image2D skyOut;

struct ElementData {
    vec4 color;                // 0-15
    int type;                  // 16-19
    float density;             // 20-23
    float viscosity;           // 24-27
    int glow;                  // 28-31
    int gemstone;              // 32-35
    float lightRadius;         // 36-39
    float lightIntensity;      // 40-43
    float ior;                 // 44-47
    float opacity;             // 48-51
    float specularPower;       // 52-55
    int _pad1, _pad2;          // 56-63
    vec4 transmissionTint;     // 64-79
    float baseHeight;          // 80-83
    float colorVariation;      // 84-87
    int animType;              // 88-91
    float mass;                // 92-95
};

layout(std430, binding = 2) buffer ElementRegistry {
    ElementData elements[];
};

uniform vec4 backgroundColor;
uniform float time;
uniform bool skyEnabled;
uniform float timeOfDay;
uniform bool showSun;

// Animation type constants
const int ANIM_NONE      = 0;
const int ANIM_LIQUID    = 1;
const int ANIM_FIRE      = 2;
const int ANIM_VOID      = 3;
const int ANIM_BLACKHOLE = 4;
const int ANIM_RAINBOW   = 5;

// HSL to RGB conversion for rainbow cycling
vec3 hsl2rgb(float h, float s, float l) {
    float c = (1.0 - abs(2.0 * l - 1.0)) * s;
    float x = c * (1.0 - abs(mod(h * 6.0, 2.0) - 1.0));
    float m = l - c * 0.5;
    vec3 rgb;
    if (h < 1.0/6.0) rgb = vec3(c, x, 0.0);
    else if (h < 2.0/6.0) rgb = vec3(x, c, 0.0);
    else if (h < 3.0/6.0) rgb = vec3(0.0, c, x);
    else if (h < 4.0/6.0) rgb = vec3(0.0, x, c);
    else if (h < 5.0/6.0) rgb = vec3(x, 0.0, c);
    else rgb = vec3(c, 0.0, x);
    return rgb + m;
}

// Helpers

uvec4 safeLoad(ivec2 pos, ivec2 size) {
    if (pos.x < 0 || pos.x >= size.x || pos.y < 0 || pos.y >= size.y)
        return uvec4(0u);
    return imageLoad(stateIn, pos);
}

float hashNoise(ivec2 pos) {
    return fract(sin(dot(vec2(pos), vec2(12.9898, 78.233))) * 43758.5453);
}

float hashNoise2(ivec2 pos) {
    return fract(sin(dot(vec2(pos), vec2(39.346, 11.135))) * 23421.6312);
}

// Sky Gradient
vec3 skyColor(float normalizedY, float tod, ivec2 pos, ivec2 size) {
    float sunElevation = sin(tod * 3.14159);

    // Night sky
    vec3 nightTop    = vec3(0.01, 0.01, 0.04);
    vec3 nightBottom = vec3(0.03, 0.03, 0.08);

    // Dawn/dusk sky
    vec3 dawnTop     = vec3(0.15, 0.15, 0.35);
    vec3 dawnBottom  = vec3(0.85, 0.45, 0.20);

    // Day sky
    vec3 dayTop      = vec3(0.25, 0.50, 0.92);
    vec3 dayBottom   = vec3(0.55, 0.75, 0.95);

    // Noon sky
    vec3 noonTop     = vec3(0.30, 0.55, 0.95);
    vec3 noonBottom  = vec3(0.65, 0.82, 0.98);

    // Sunset
    vec3 sunsetTop   = vec3(0.20, 0.15, 0.40);
    vec3 sunsetBottom= vec3(0.95, 0.40, 0.15);

    // Blend based on time of day
    vec3 topColor, bottomColor;

    if (tod < 0.15) {
        float t = tod / 0.15;
        topColor    = mix(nightTop, dawnTop, t * t);
        bottomColor = mix(nightBottom, dawnBottom, t * t);
    }
    else if (tod < 0.30) {
        float t = (tod - 0.15) / 0.15;
        topColor    = mix(dawnTop, dayTop, t);
        bottomColor = mix(dawnBottom, dayBottom, t);
    }
    else if (tod < 0.50) {
        float t = (tod - 0.30) / 0.20;
        topColor    = mix(dayTop, noonTop, t);
        bottomColor = mix(dayBottom, noonBottom, t);
    }
    else if (tod < 0.70) {
        float t = (tod - 0.50) / 0.20;
        topColor    = mix(noonTop, dayTop, t);
        bottomColor = mix(noonBottom, dayBottom, t);
    }
    else if (tod < 0.80) {
        float t = (tod - 0.70) / 0.10;
        topColor    = mix(dayTop, sunsetTop, t);
        bottomColor = mix(dayBottom, sunsetBottom, t);
    }
    else if (tod < 0.90) {
        float t = (tod - 0.80) / 0.10;
        topColor    = mix(sunsetTop, dawnTop * 0.6, t);
        bottomColor = mix(sunsetBottom, dawnBottom * 0.5, t);
    }
    else {
        float t = (tod - 0.90) / 0.10;
        topColor    = mix(dawnTop * 0.6, nightTop, t);
        bottomColor = mix(dawnBottom * 0.5, nightBottom, t);
    }

    // Vertical gradient
    vec3 sky = mix(bottomColor, topColor, normalizedY);

    // Stars at night
    if (sunElevation < 0.2) {
        float nightFactor = 1.0 - clamp(sunElevation / 0.2, 0.0, 1.0);
        float star = hashNoise(pos * 7);
        if (star > 0.997) {
            float twinkle = sin(time * 3.0 + star * 100.0) * 0.3 + 0.7;
            sky += vec3(twinkle * nightFactor * 0.8);
        }
    }

    // Sun disc
    if (showSun && sunElevation > -0.05) {
        float sunX = 0.5;
        float sunY = -0.2 + sunElevation * 1.0;

        float normX = float(pos.x) / float(size.x);

        float dx = normX - sunX;
        float dy = normalizedY - sunY;
        float aspect = float(size.x) / float(size.y);
        dx *= aspect;

        float distToSun = sqrt(dx * dx + dy * dy);

        float sunRadius = 0.04;
        float glowRadius = 0.15;

        vec3 sunColor;
        if (sunElevation < 0.3) {
            float t = sunElevation / 0.3;
            sunColor = mix(vec3(1.0, 0.4, 0.1), vec3(1.0, 0.95, 0.8), t);
        } else {
            sunColor = vec3(1.0, 0.98, 0.9);
        }

        if (distToSun < glowRadius) {
            float glow = 1.0 - smoothstep(0.0, glowRadius, distToSun);
            glow = glow * glow;
            float glowStrength = clamp(sunElevation * 3.0 + 0.2, 0.0, 0.6);
            sky += sunColor * glow * glowStrength;
        }

        if (distToSun < sunRadius) {
            float softEdge = 1.0 - smoothstep(sunRadius * 0.8, sunRadius, distToSun);
            sky = mix(sky, sunColor, softEdge * clamp(sunElevation * 5.0 + 0.5, 0.0, 1.0));
        }
    }

    return clamp(sky, 0.0, 1.0);
}

// Phase 3: Data-driven height map
float getHeight(ivec2 pos, ivec2 size) {
    uvec4 state = safeLoad(pos, size);
    uint elem = state.r;
    if (elem == EMPTY || elem >= MAX_ELEMENTS) return 0.0;

    // Read base height directly from element data
    float baseHeight = elements[elem].baseHeight;

    int type = elements[elem].type;

    // Granular: add slight noise to base height
    if (type == 1) {
        baseHeight += hashNoise(pos) * 0.2;
    }

    // Gemstones: faceted height for sparkle
    if (elements[elem].gemstone == 1) {
        float facet = floor(hashNoise(pos) * 4.0) / 4.0;
        baseHeight = 0.7 + facet * 0.3;
    }

    return baseHeight;
}

// Normal Computation using animType
vec3 computeNormal(ivec2 pos, ivec2 size, uint element) {
    if (element == EMPTY || element >= MAX_ELEMENTS) {
        return vec3(0.0, 0.0, 1.0);
    }

    int type = elements[element].type;
    int anim = elements[element].animType;

    // Gemstone normals (shimmer)
    if (elements[element].gemstone == 1) {
        float facetSeed = floor(hashNoise(pos) * 6.0);
        float shimmerPhase = time * 2.0 + facetSeed * 1.047;
        float nx = sin(shimmerPhase) * 0.4 + (hashNoise(pos) - 0.5) * 0.3;
        float ny = cos(shimmerPhase * 0.7) * 0.4 + (hashNoise2(pos) - 0.5) * 0.3;
        float nz = 1.0;
        return normalize(vec3(nx, ny, nz));
    }

    // Phase 3: Use animType for animation-driven normals
    if (anim == ANIM_BLACKHOLE) {
        float angle = time * 3.0 + hashNoise(pos) * 6.28;
        float warp = 0.6;
        return normalize(vec3(sin(angle) * warp, cos(angle) * warp, 0.3));
    }

    if (anim == ANIM_VOID) {
        float distort = sin(time * 2.0 + hashNoise(pos) * 10.0) * 0.3;
        return normalize(vec3(distort, distort * 0.5, 0.8));
    }

    if (anim == ANIM_LIQUID || type == 2) {
        float wave = sin(time * 2.0 + float(pos.x) * 0.5) * 0.15;
        float wave2 = cos(time * 1.5 + float(pos.y) * 0.3) * 0.1;
        return normalize(vec3(wave, wave2, 1.0));
    }

    if (type == 3) {
        float puff = sin(float(pos.x) * 0.8 + time) * 0.1;
        float puff2 = cos(float(pos.y) * 0.6 + time * 0.7) * 0.1;
        return normalize(vec3(puff, puff2, 1.0));
    }

    float hL = getHeight(pos + ivec2(-1, 0), size);
    float hR = getHeight(pos + ivec2( 1, 0), size);
    float hD = getHeight(pos + ivec2(0, -1), size);
    float hU = getHeight(pos + ivec2(0,  1), size);

    float dx = hR - hL;
    float dy = hU - hD;

    if (type == 1) {
        dx += (hashNoise(pos) - 0.5) * 0.15;
        dy += (hashNoise2(pos) - 0.5) * 0.15;
    }

    return normalize(vec3(-dx, -dy, 0.5));
}

// Phase 3: Data-driven specular power (replaces getSpecularPower)
// Now simply reads from the element buffer
float getSpecularPower(uint element) {
    if (element == EMPTY || element >= MAX_ELEMENTS) return 0.0;
    return elements[element].specularPower;
}

vec4 getColor(uint element, uint life, ivec2 pos, ivec2 size) {
    // Phase 3: Use data-driven colorVariation instead of hardcoded 0.1
    float variation = hashNoise(pos);

    if (element == EMPTY) {
        if (skyEnabled) {
            float normalizedY = float(pos.y) / float(size.y);
            vec3 sky = skyColor(normalizedY, timeOfDay, pos, size);
            return vec4(sky, 1.0);
        }
        return backgroundColor;
    }

    if (element >= MAX_ELEMENTS) {
        return vec4(1.0, 0.0, 1.0, 1.0);
    }

    vec4 baseColor = elements[element].color;
    float colorVar = elements[element].colorVariation;
    vec3 varied = baseColor.rgb + (variation - 0.5) * colorVar;

    int type = elements[element].type;
    int anim = elements[element].animType;

    // BOMB
    if (element == BOMB) {
        float fuseProgress = float(life) / 250.0;
        fuseProgress = clamp(fuseProgress, 0.0, 1.0);
        vec3 bombColor = vec3(0.2, 0.2, 0.2);
        float flashRate = 3.0 + fuseProgress * 20.0;
        float flash = sin(time * flashRate) * 0.5 + 0.5;
        flash *= fuseProgress;
        vec3 warningColor = vec3(1.0, 0.2, 0.0);
        bombColor = mix(bombColor, warningColor, flash);
        bombColor += (variation - 0.5) * 0.05;
        return vec4(clamp(bombColor, 0.0, 1.0), 1.0);
    }

    // Phase 3: Use animType for special rendering instead of element ID checks
    if (anim == ANIM_VOID) {
        float distort = sin(time * 1.5 + variation * 10.0 + float(pos.x) * 0.3) * 0.03;
        vec3 voidColor = vec3(0.02 + distort, 0.0, 0.05 + distort * 2.0);
        float edgeNoise = hashNoise2(pos);
        voidColor += vec3(0.03, 0.0, 0.06) * edgeNoise * sin(time * 2.0 + float(pos.y) * 0.5) * 0.5;
        return vec4(clamp(voidColor, 0.0, 1.0), 1.0);
    }

    // Glowing elements - pulsing effect
    if (elements[element].glow == 1 && anim != ANIM_FIRE && element != LIGHT) {
        float pulse = sin(time * 3.0 + variation * 6.28) * 0.5 + 0.5;
        varied.g += pulse * 0.3;
        varied.b += pulse * 0.1;
    }

    // Phase 3: BlackHole via animType
    if (anim == ANIM_BLACKHOLE) {
        vec3 holeColor = vec3(0.0);
        float angle = atan(float(pos.y), float(pos.x)) + time * 2.0;
        float ring = sin(angle * 3.0 + variation * 6.28) * 0.5 + 0.5;
        vec3 accretionColor = mix(vec3(0.4, 0.1, 0.6), vec3(0.8, 0.3, 0.05), ring);
        holeColor += accretionColor * 0.15 * (sin(time * 4.0 + variation * 3.14) * 0.3 + 0.7);
        return vec4(clamp(holeColor, 0.0, 1.0), 1.0);
    }

    // Light element
    if (element == LIGHT) {
        float pulse = sin(time * 1.5 + variation * 3.14) * 0.05 + 0.95;
        varied = vec3(1.0, 0.98, 0.9) * pulse;
        return vec4(varied, 1.0);
    }

    // Phase 3: Fire via animType
    if (anim == ANIM_FIRE) {
        float flicker = sin(time * 10.0 + variation * 10.0) * 0.5 + 0.5;
        float lifeFactor = float(life) / 255.0;
        varied = vec3(1.0, 0.5 * lifeFactor + flicker * 0.3, 0.1);
        return vec4(varied, 0.9 * lifeFactor);
    }

    // SMOKE
    if (element == SMOKE) {
        float lifeFactor = float(life) / 200.0;
        lifeFactor = clamp(lifeFactor, 0.0, 1.0);
        vec3 freshColor = vec3(0.3, 0.3, 0.32);
        vec3 oldColor = vec3(0.6, 0.6, 0.65);
        vec3 smokeColor = mix(oldColor, freshColor, lifeFactor);
        smokeColor += (variation - 0.5) * 0.08;
        float variation2 = hashNoise2(pos);
        smokeColor.r += (variation2 - 0.5) * 0.05;
        float alpha = lifeFactor * 0.5 + 0.05;
        return vec4(smokeColor, alpha);
    }

    // STEAM - translucent white wisps
    if (element == STEAM) {
        float wisp = sin(time * 3.0 + float(pos.x) * 0.4 + float(pos.y) * 0.3) * 0.1;
        vec3 steamColor = vec3(0.85, 0.90, 0.95) + wisp;
        steamColor += (variation - 0.5) * 0.06;
        float alpha = 0.2 + sin(time * 2.0 + variation * 6.28) * 0.08;
        return vec4(clamp(steamColor, 0.0, 1.0), alpha);
    }

    // CLOUD - puffy white/gray
    if (element == CLOUD) {
        float lifeFactor = float(life) / 255.0;
        float puff = sin(time * 0.5 + float(pos.x) * 0.2) * 0.03;
        float puff2 = cos(time * 0.3 + float(pos.y) * 0.15) * 0.02;
        vec3 cloudColor = vec3(0.88 + puff, 0.90 + puff2, 0.94);
        cloudColor += (variation - 0.5) * 0.05;
        // Darken slightly as life decreases (rain clouds)
        cloudColor *= 0.7 + lifeFactor * 0.3;
        float alpha = 0.5 + lifeFactor * 0.3;
        return vec4(clamp(cloudColor, 0.0, 1.0), alpha);
    }

    // ICE - crystalline with subtle shimmer
    if (element == ICE) {
        float shimmer = sin(time * 1.5 + float(pos.x) * 0.6 + float(pos.y) * 0.4) * 0.05;
        vec3 iceColor = vec3(0.70 + shimmer, 0.85 + shimmer * 0.5, 0.95);
        iceColor += (variation - 0.5) * 0.06;
        float sparkle = pow(max(sin(time * 4.0 + variation * 15.0), 0.0), 12.0) * 0.15;
        iceColor += sparkle;
        return vec4(clamp(iceColor, 0.0, 1.0), 0.9);
    }

    // LIQUID NITROGEN - cold blue with frost vapor
    if (element == LIQUIDNITROGEN) {
        float frost = sin(time * 3.0 + float(pos.x) * 0.7 + float(pos.y) * 0.5) * 0.08;
        vec3 lnColor = vec3(0.65 + frost, 0.82 + frost * 0.5, 1.0);
        lnColor += (variation - 0.5) * 0.08;
        float vapor = pow(max(sin(time * 5.0 + variation * 12.0), 0.0), 6.0) * 0.1;
        lnColor += vapor;
        return vec4(clamp(lnColor, 0.0, 1.0), 0.6);
    }

    // DRY ICE - frosty white with sublimation shimmer
    if (element == DRYICE) {
        float sublimate = sin(time * 2.0 + float(pos.x) * 0.4 + float(pos.y) * 0.3) * 0.04;
        vec3 diColor = vec3(0.85 + sublimate, 0.90 + sublimate * 0.5, 0.95);
        diColor += (variation - 0.5) * 0.06;
        return vec4(clamp(diColor, 0.0, 1.0), 0.9);
    }

    // MOLTEN IRON - intense orange-white glow
    if (element == MOLTENIRON) {
        float flicker = sin(time * 8.0 + variation * 8.0) * 0.5 + 0.5;
        vec3 miColor = vec3(1.0, 0.55 + flicker * 0.15, 0.1);
        miColor += (variation - 0.5) * 0.1;
        return vec4(clamp(miColor, 0.0, 1.0), 1.0);
    }

    // FUSER - pulsing golden glow
    if (element == FUSER) {
        float pulse = sin(time * 4.0 + variation * 6.28) * 0.15 + 0.85;
        vec3 fuserColor = vec3(1.0, 0.85, 0.0) * pulse;
        fuserColor += (variation - 0.5) * 0.05;
        return vec4(clamp(fuserColor, 0.0, 1.0), 1.0);
    }

    // RAINBOW NEON - cycles through color spectrum
    if (anim == ANIM_RAINBOW) {
        float hue = fract(time * 0.15 + variation * 0.1);
        vec3 rainbowColor = hsl2rgb(hue, 1.0, 0.55);
        float pulse = sin(time * 3.0 + variation * 6.28) * 0.1 + 0.9;
        rainbowColor *= pulse;
        return vec4(clamp(rainbowColor, 0.0, 1.0), 1.0);
    }

    // Grass
    if (element == GRASS) {
        float lifeFactor = float(life) / 255.0;
        varied.r += (1.0 - lifeFactor) * 0.15;
        varied.g -= (1.0 - lifeFactor) * 0.1;
    }

    // Plant
    if (element == PLANT) {
        float sway = sin(time * 1.5 + float(pos.x) * 0.3 + float(pos.y) * 0.2) * 0.04;
        varied.g += sway + variation * 0.12;
        varied.r += variation * 0.05;
    }

    // Sapling
    if (element == SAPLING) {
        float pulse = sin(time * 4.0) * 0.15 + 0.85;
        varied *= pulse;
    }

    // AEROGEL - translucent blue shimmer with iridescence
    if (element == AEROGEL) {
        float shimmer = sin(time * 2.0 + variation * 12.0 + float(pos.x) * 0.3) * 0.1;
        varied += shimmer;
        // Slight iridescent tint shift
        float iri = sin(time * 0.5 + float(pos.x + pos.y) * 0.1) * 0.08;
        varied.r += iri;
        varied.b -= iri;
        varied = clamp(varied, 0.0, 1.0);
    }

    // HEAVY SAND - dark iron-flecked granules with subtle metallic glint
    if (element == HEAVYSAND) {
        float glint = pow(max(sin(time * 3.0 + variation * 25.0), 0.0), 12.0) * 0.15;
        varied += glint;
        // Dark iron flecks
        if (variation > 0.7) {
            varied *= 0.7;
        }
    }

    // Gemstones
    if (elements[element].gemstone == 1) {
        float lum = dot(varied, vec3(0.299, 0.587, 0.114));
        varied = mix(vec3(lum), varied, 1.4);
        float sparkle = pow(max(sin(time * 5.0 + variation * 20.0), 0.0), 8.0);
        varied += sparkle * 0.3;
    }

    // Liquid shimmer (also triggered by animType)
    if (type == 2 || anim == ANIM_LIQUID) {
        float shimmer = sin(time * 2.0 + float(pos.x) * 0.5 + float(pos.y) * 0.3) * 0.05;
        varied += shimmer;
    }

    return vec4(clamp(varied, 0.0, 1.0), baseColor.a);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(stateIn);
    if (pos.x >= size.x || pos.y >= size.y) return;

    uvec4 state = imageLoad(stateIn, pos);
    uint element = state.r;
    uint life = state.g;

    // Output color
    vec4 color = getColor(element, life, pos, size);
    imageStore(colorOut, pos, color);

    // Output normal + specular (Phase 3: data-driven specular)
    vec3 normal = computeNormal(pos, size, element);
    float specPower = getSpecularPower(element);
    imageStore(normalOut, pos, vec4(normal, specPower));

    // Output sky color for background blending in composite
    if (skyEnabled) {
        float normalizedY = float(pos.y) / float(size.y);
        vec3 sky = skyColor(normalizedY, timeOfDay, pos, size);
        imageStore(skyOut, pos, vec4(sky, 1.0));
    } else {
        imageStore(skyOut, pos, backgroundColor);
    }
}
