#version 460 core

layout(local_size_x = 64) in;

layout(rgba16f, binding = 0) uniform readonly image2D radianceField;
layout(rgba8ui, binding = 1) uniform readonly uimage2D stateIn;

struct ElementData {
    vec4 color;
    int type;
    float density;
    float viscosity;
    float probability;
    int flammability;
    int glow;
    int maxLife;
    int gemstone;
    float lightRadius;
    float lightIntensity;
    float ior;
    int _pad;
};

layout(std430, binding = 2) buffer ElementRegistry {
    ElementData elements[];
};

// Cascade radiance storage: flat array of vec4
// Layout: cascade levels are stored contiguously.
// For cascade N: offset = cascadeOffsets[N]
// Index within cascade: (probeY * probeCountX + probeX) * raysPerProbe + rayIndex
layout(std430, binding = 7) buffer CascadeRadiance {
    vec4 cascadeData[];
};

// Uniforms set per-dispatch
uniform int   cascadeLevel;      // Which cascade level we're computing (N)
uniform int   numCascades;       // Total number of cascade levels
uniform ivec2 worldSize;         // World dimensions in pixels
uniform float time;
uniform bool skyEnabled;
uniform float timeOfDay;

// Cascade configuration constants (set via #define from CPU)
#ifndef BASE_RAYS
#define BASE_RAYS 4
#endif

#ifndef MAX_CASCADES
#define MAX_CASCADES 8
#endif

// Pre-computed offsets into cascadeData for each level
uniform int cascadeOffsets[MAX_CASCADES];
uniform int probeCountX[MAX_CASCADES];
uniform int probeCountY[MAX_CASCADES];

// Base interval length for cascade 0 (in pixels)
// This controls how far cascade 0 rays reach.
// Cascade N interval starts at: baseInterval * (1 - 4^N) / (1 - 4)
//                    and length: baseInterval * 4^N
const float BASE_INTERVAL = 1.0;

// Helpers

bool inBounds(ivec2 pos) {
    return pos.x >= 0 && pos.x < worldSize.x && pos.y >= 0 && pos.y < worldSize.y;
}

vec3 getMaterialTint(uint elem) {
    if (elem == EMPTY || elem >= MAX_ELEMENTS) return vec3(1.0);
    if (elem == BLACKHOLE) return vec3(0.0);
    if (elem == VOID) return vec3(0.1, 0.0, 0.15);
    if (elements[elem].gemstone == 1) return elements[elem].color.rgb;
    if (elem == WATER) return vec3(0.7, 0.8, 1.0);
    if (elem == LAVA) return vec3(1.0, 0.6, 0.2);
    return vec3(1.0);
}

// Compute interval scale factor using geometric sequence (4x branching)
// intervalScale(0) = 0, intervalScale(1) = 1, intervalScale(2) = 4, intervalScale(3) = 16, ...
// So cascade N traces from intervalScale(N) to intervalScale(N+1) in units of BASE_INTERVAL
float intervalScale(int cascadeIndex) {
    if (cascadeIndex <= 0) return 0.0;
    // 4^(cascadeIndex - 1) summed geometrically = (4^cascadeIndex - 1) / 3
    // But simpler: just use the direct formula
    // Start = sum of previous lengths = BASE_INTERVAL * (4^0 + 4^1 + ... + 4^(N-1))
    //       = BASE_INTERVAL * (4^N - 1) / 3
    return float(uint(1) << (2 * cascadeIndex));  // = 4^cascadeIndex
}

// Read radiance from a specific cascade level at a probe+ray index
vec4 readCascade(int level, int probeX, int probeY, int rayIdx) {
    int pcx = probeCountX[level];
    int pcy = probeCountY[level];

    // Clamp probe coordinates
    probeX = clamp(probeX, 0, pcx - 1);
    probeY = clamp(probeY, 0, pcy - 1);

    int numRays = BASE_RAYS * (1 << level);
    int idx = cascadeOffsets[level] + (probeY * pcx + probeX) * numRays + rayIdx;
    return cascadeData[idx];
}

// Write radiance to current cascade level
void writeCascade(int level, int probeX, int probeY, int rayIdx, vec4 value) {
    int pcx = probeCountX[level];
    int numRays = BASE_RAYS * (1 << level);
    int idx = cascadeOffsets[level] + (probeY * pcx + probeX) * numRays + rayIdx;
    cascadeData[idx] = value;
}

// Merge two connected intervals with respect to their visibility term
// near.a = 1.0 means "no hit" (transparent), 0.0 means "fully occluded"
vec4 mergeIntervals(vec4 near, vec4 far) {
    return vec4(near.rgb + far.rgb * near.a, near.a * far.a);
}

// Bilinear interpolation of cascade N+1 at a world-space position and angle
vec4 sampleUpperCascade(int upperLevel, vec2 worldPos, float angle) {
    if (upperLevel >= numCascades) return vec4(0.0);

    int upperPcx = probeCountX[upperLevel];
    int upperPcy = probeCountY[upperLevel];
    int upperSpacing = 1 << upperLevel;
    int upperRays = BASE_RAYS * (1 << upperLevel);

    // Convert world position to probe-space coordinates (continuous)
    vec2 probeCoord = worldPos / float(upperSpacing) - 0.5;

    // Bilinear probe indices
    int px0 = int(floor(probeCoord.x));
    int py0 = int(floor(probeCoord.y));
    int px1 = px0 + 1;
    int py1 = py0 + 1;
    float fx = fract(probeCoord.x);
    float fy = fract(probeCoord.y);

    // Angular interpolation
    float normalizedAngle = angle / (2.0 * 3.14159265);
    if (normalizedAngle < 0.0) normalizedAngle += 1.0;

    // Half-texel offset for ray center alignment
    float rayCoord = normalizedAngle * float(upperRays) - 0.5;
    if (rayCoord < 0.0) rayCoord += float(upperRays);

    int r0 = int(floor(rayCoord)) % upperRays;
    int r1 = (r0 + 1) % upperRays;
    float fr = fract(rayCoord);

    // Sample 8 points: 4 spatial * 2 angular, then bilinear+lerp
    vec4 s00r0 = readCascade(upperLevel, px0, py0, r0);
    vec4 s10r0 = readCascade(upperLevel, px1, py0, r0);
    vec4 s01r0 = readCascade(upperLevel, px0, py1, r0);
    vec4 s11r0 = readCascade(upperLevel, px1, py1, r0);

    vec4 s00r1 = readCascade(upperLevel, px0, py0, r1);
    vec4 s10r1 = readCascade(upperLevel, px1, py0, r1);
    vec4 s01r1 = readCascade(upperLevel, px0, py1, r1);
    vec4 s11r1 = readCascade(upperLevel, px1, py1, r1);

    // Bilinear spatial interpolation for each angular sample
    vec4 interpR0 = mix(mix(s00r0, s10r0, fx), mix(s01r0, s11r0, fx), fy);
    vec4 interpR1 = mix(mix(s00r1, s10r1, fx), mix(s01r1, s11r1, fx), fy);

    // Angular interpolation
    return mix(interpR0, interpR1, fr);
}

// Compute sky radiance for a given ray direction
vec3 getSkyRadiance(vec2 dir) {
    if (!skyEnabled) return vec3(0.0);

    float sunElevation = sin(timeOfDay * 3.14159);

    // Only inject sky for rays pointing upward
    // dir.y > 0 means the ray is going upward in world space
    if (dir.y <= 0.0) return vec3(0.0);

    // Sky color based on time of day
    vec3 skyLight;
    if (sunElevation < 0.0) {
        // Night
        skyLight = vec3(0.02, 0.02, 0.04);
    } else if (sunElevation < 0.3) {
        float t = sunElevation / 0.3;
        skyLight = mix(vec3(0.05, 0.03, 0.08), vec3(1.0, 0.5, 0.2), t);
    } else {
        skyLight = vec3(1.0, 0.98, 0.92);
    }

    float skyFactor = max(sunElevation, 0.0);
    // Weight by how upward the ray is pointing (hemisphere cosine weighting)
    float upFactor = dir.y;

    return skyLight * skyFactor * upFactor * 0.5;
}

void main() {
    // Each invocation handles one probe+ray pair at the current cascade level
    int N = cascadeLevel;
    int pcx = probeCountX[N];
    int pcy = probeCountY[N];
    int numRays = BASE_RAYS * (1 << N);
    int totalProbes = pcx * pcy;
    int totalWork = totalProbes * numRays;

    uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(totalWork)) return;

    // Decode probe index and ray index
    int rayIdx   = int(gid) % numRays;
    int probeIdx = int(gid) / numRays;
    int probeX   = probeIdx % pcx;
    int probeY   = probeIdx / pcx;

    // Probe center in world space
    int spacing = 1 << N;
    vec2 probeCenter = (vec2(probeX, probeY) + 0.5) * float(spacing);

    // Ray direction: evenly spaced angles with half-step offset
    float angleStep = 2.0 * 3.14159265 / float(numRays);
    float angle = angleStep * (float(rayIdx) + 0.5);
    vec2 dir = vec2(cos(angle), sin(angle));

    // --- Interval range using geometric sequence (4x branching) ---
    // Cascade N starts at: BASE_INTERVAL * (4^N - 1) / 3
    //         ends at:     BASE_INTERVAL * (4^(N+1) - 1) / 3
    // Length of interval: BASE_INTERVAL * 4^N
    float scale_start = (N == 0) ? 0.0 : (intervalScale(N) - 1.0) / 3.0;
    float scale_end   = (intervalScale(N + 1) - 1.0) / 3.0;
    float rangeStart  = BASE_INTERVAL * scale_start;
    float rangeEnd    = BASE_INTERVAL * scale_end;

    // Clamp maximum range to avoid excessive marching
    float maxRange = length(vec2(worldSize));
    rangeEnd = min(rangeEnd, maxRange);

    // Ray march through the interval
    vec3 accumulatedLight = vec3(0.0);
    float visibility = 1.0;  // 1.0 = no hit yet, 0.0 = fully occluded
    vec3 tint = vec3(1.0);   // Accumulated color tint from transparent materials

    float stepSize = 1.0;    // March 1 pixel at a time
    int maxSteps = int(ceil(rangeEnd - rangeStart));

    bool hitBoundary = false;

    for (int step = 0; step < maxSteps && visibility > 0.01; step++) {
        float t = rangeStart + float(step) * stepSize + 0.5;
        if (t >= rangeEnd) break;

        ivec2 samplePos = ivec2(probeCenter + dir * t);

        if (!inBounds(samplePos)) {
            hitBoundary = true;
            break;
        }

        // Read the radiance field (emission + opacity)
        vec4 rf = imageLoad(radianceField, samplePos);
        vec3 emission = rf.rgb;
        float opacity = rf.a;

        // Material tint for transparent materials
        uint elem = imageLoad(stateIn, samplePos).r;
        vec3 matTint = getMaterialTint(elem);

        // Accumulate emission weighted by current visibility
        // Emission is the light the material produces — don't multiply by opacity again
        accumulatedLight += emission * visibility * tint;

        // Update visibility and tint based on opacity
        visibility *= (1.0 - opacity);
        tint *= mix(vec3(1.0), matTint, opacity);
    }

    // --- Handle sky and upper cascade merging ---
    // Only the HIGHEST cascade injects sky light at boundaries
    // Other cascades rely on merging with the cascade above them
    if (hitBoundary && N == numCascades - 1) {
        // Inject sky radiance for the highest cascade
        vec3 skyRad = getSkyRadiance(dir);
        accumulatedLight += skyRad * visibility * tint;
        // Don't zero out visibility — let it propagate
    }

    // If there's remaining visibility and we're not the highest cascade,
    // merge with the next cascade up using proper interval merging
    if (visibility > 0.01 && N + 1 < numCascades && !hitBoundary) {
        // Sample point is at the END of our tracing interval
        vec2 samplePoint = probeCenter + dir * rangeEnd;
        vec4 upperRadiance = sampleUpperCascade(N + 1, samplePoint, angle);

        // Proper interval merge: near.rgb + far.rgb * near.visibility
        vec4 nearInterval = vec4(accumulatedLight, visibility);
        vec4 merged = mergeIntervals(nearInterval, upperRadiance);
        accumulatedLight = merged.rgb;
        visibility = merged.a;
    }

    // Write result: RGB = radiance along this ray, A = visibility (1=no hit, 0=hit)
    writeCascade(N, probeX, probeY, rayIdx, vec4(accumulatedLight, visibility));
}
